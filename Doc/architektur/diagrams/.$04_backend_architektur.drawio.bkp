        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml 04_backend_architektur\n!theme plain\nskinparam defaultFontName \&quot;Liberation Sans\&quot;, Arial, sans-serif\nskinparam roundcorner 6\nskinparam shadowing false\nskinparam packageStyle rectangle\n\npackage \&quot;NestJS Backend (Modular Monolith)\&quot; {\n\n    package \&quot;App Core Layer\&quot; {\n        component \&quot;AppModule\\n(MongooseModule, ObserveModule)\&quot; as AppModule #E1D5E7\n        component \&quot;Global ValidationPipe\\n(whitelist: true, transform: true)\&quot; as Pipe #E1D5E7\n    }\n\n    package \&quot;AuthModule (@nestjs/jwt, @nestjs/passport)\&quot; {\n        component \&quot;AuthController\\n(/api/auth)\&quot; as AuthCtrl #FFF2CC\n        component \&quot;AuthService\&quot; as AuthSvc #FFF2CC\n        component \&quot;JwtService\\n(@nestjs/jwt)\&quot; as JwtSvc #FFF2CC\n        component \&quot;JwtStrategy\\n(passport-jwt)\&quot; as JwtStrat #FFF2CC\n        component \&quot;JwtAuthGuard\\n(extends AuthGuard(&#39;jwt&#39;))\&quot; as JwtGuard #FFF2CC\n        component \&quot;AuthUtils / bcrypt\\n(hash, compare)\&quot; as AuthUtils #FFF2CC\n        component \&quot;RegisterDto / LoginDto\&quot; as AuthDTO #FFF2CC\n    }\n\n    package \&quot;UsersModule\&quot; {\n        component \&quot;UsersController\\n(/api/users)\&quot; as UsersCtrl #DAE8FC\n        component \&quot;UsersService\&quot; as UsersSvc #DAE8FC\n        component \&quot;UpdateUserDto\&quot; as UsersDTO #DAE8FC\n        component \&quot;Person Schema\\n(Mongoose Model)\&quot; as PersonSchema #DAE8FC\n        component \&quot;EmergencyContact Schema\&quot; as EmergSchema #DAE8FC\n    }\n\n    package \&quot;ToursModule\&quot; {\n        component \&quot;ToursController\\n(/api/tours)\&quot; as ToursCtrl #D5E8D4\n        component \&quot;ToursService\&quot; as ToursSvc #D5E8D4\n        component \&quot;CreateTourDto / UpdateTourDto\\nSecurityMatrixDto / SetUserRoleDto\&quot; as ToursDTO #D5E8D4\n        component \&quot;Tour Schema\\n(Mongoose Model)\&quot; as TourSchema #D5E8D4\n    }\n}\n\ndatabase \&quot;MongoDB (Database: nest)\&quot; {\n    collections \&quot;people\&quot; as ColPeople #FFE6CC\n    collections \&quot;tours\&quot; as ColTours #FFE6CC\n}\n\ncloud \&quot;HTTP Request (from Angular Frontend)\&quot; as HTTPReq\n\nHTTPReq --&gt; Pipe : \&quot;1. Request Data Validation\&quot;\nPipe --&gt; AuthCtrl : \&quot;/api/auth/*\&quot;\nPipe --&gt; UsersCtrl : \&quot;/api/users/*\&quot;\nPipe --&gt; ToursCtrl : \&quot;/api/tours/*\&quot;\n\nUsersCtrl ..&gt; JwtGuard : \&quot;Geschützt durch Guard\&quot;\nToursCtrl ..&gt; JwtGuard : \&quot;Geschützt durch Guard\&quot;\nJwtGuard ..&gt; JwtStrat : \&quot;Passport JWT-Strategie\&quot;\nJwtStrat ..&gt; JwtSvc : \&quot;Validiert Signatur\&quot;\n\nAuthCtrl --&gt; AuthSvc\nAuthSvc --&gt; JwtSvc : \&quot;sign(payload)\&quot;\nAuthSvc --&gt; AuthUtils : \&quot;bcrypt.compare(), bcrypt.hash()\&quot;\nAuthSvc --&gt; UsersSvc : \&quot;findByEmail(), create()\&quot;\n\nUsersCtrl --&gt; UsersSvc\nUsersSvc --&gt; PersonSchema : \&quot;CRUD / MongoDB Query\&quot;\nPersonSchema *-- EmergSchema : \&quot;Eingebettetes Dokument\&quot;\nPersonSchema --&gt; ColPeople\n\nToursCtrl --&gt; ToursSvc\nToursCtrl --&gt; UsersSvc : \&quot;findTourMembers(), getEmergencyContact()\&quot;\nToursSvc --&gt; TourSchema : \&quot;CRUD / MongoDB Query\&quot;\nTourSchema --&gt; ColTours\n\nAppModule ..&gt; AuthCtrl\nAppModule ..&gt; UsersCtrl\nAppModule ..&gt; ToursCtrl\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dWTXE-_CBuz7ooYi7NfG-1">
